                      "maximum": 1
                    },
                    "config": {
                      "default": {},
                      "type": "object",
                      "properties": {
                        "strings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
