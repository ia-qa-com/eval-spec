{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Human-readable contract name"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+",
          "description": "Contract version (e.g. 1.0)"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "tags": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          }
        },
        "author": {
          "type": "string",
          "maxLength": 200
        },
        "created_at": {
          "description": "ISO date string",
          "type": "string"
        },
        "model": {
          "description": "Default model id",
          "type": "string",
          "maxLength": 100
        },
        "provider": {
          "description": "Default provider: openai | anthropic | google | groq | deepseek | xai | mistral | huggingface",
          "type": "string",
          "maxLength": 50
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "system_prompt": {
          "type": "string",
          "maxLength": 10000
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "scenarios": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w\\-]+$"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000,
            "description": "User prompt sent to the model"
          },
          "ground_truth": {
            "description": "Expected correct answer",
            "type": "string",
            "maxLength": 50000
          },
          "system_prompt": {
            "type": "string",
            "maxLength": 10000
          },
          "model": {
            "type": "string",
            "maxLength": 100
          },
          "provider": {
            "type": "string",
            "maxLength": 50
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "tags": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 50
            }
          },
          "skip": {
            "default": false,
            "description": "Skip this scenario",
            "type": "boolean"
          },
          "expectations": {
            "type": "object",
            "properties": {
              "language": {
                "description": "Assertion: the output is in this ISO 639-1 language. Not evaluated (never passed) on an output too short to tell.",
                "type": "string",
                "enum": [
                  "en",
                  "fr",
                  "es",
                  "de",
                  "it",
                  "pt",
                  "nl",
                  "ru",
                  "zh",
                  "ja",
                  "ko",
                  "ar",
                  "pl",
                  "tr",
                  "sv"
                ]
              },
              "min_length": {
                "description": "Assertion: at least this many characters",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "max_length": {
                "description": "Assertion: at most this many characters",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "no_hallucination": {
                "description": "Assertion: the output is lexically grounded in ground_truth. Not evaluated (never passed) without a ground_truth.",
                "type": "boolean"
              },
              "no_toxicity": {
                "description": "Assertion: the output is not toxic",
                "type": "boolean"
              },
              "json_output": {
                "description": "Assertion: the output is valid JSON",
                "type": "boolean"
              },
              "contains": {
                "description": "Assertion: every string appears (case-insensitive)",
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "not_contains": {
                "description": "Assertion: no string appears (case-insensitive)",
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "regex": {
                "description": "Assertion: the output matches this regex",
                "type": "string",
                "maxLength": 500
              },
              "min_score": {
                "description": "Overrides the global min_score for this scenario",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": false,
            "description": "Overrides the global expectations field by field: a contains here replaces the global contains"
          },
          "evaluators": {
            "description": "Replaces the contract evaluators for this scenario, e.g. a judge with its own rubric",
            "maxItems": 20,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "exact_match"
                    },
                    "weight": {
                      "default": 1,
                      "description": "Relative weight in the score (default 1)",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "config": {
                      "default": {},
                      "type": "object",
                      "properties": {},
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "contains_check"
                    },
                    "weight": {
                      "default": 1,
                      "description": "Relative weight in the score (default 1)",
